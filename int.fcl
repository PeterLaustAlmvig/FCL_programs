Interpreter(prog, input_vars):
init:
  store := '();
  entry := hd(prog);
  next_block := entry;
  vars := hd(tl(prog));
  blocks := tl(tl(prog));
  goto set_vars_loop;

set_vars_loop:
  if input_vars = '() goto eval_prog else goto set_var;

set_var:
  var := hd(vars);
  vars := tl(vars);
  input := hd(input_vars);
  input_vars := tl(input_vars);
  store := cons(list(var, input), store);
  if vars = '() goto check_input_empty else goto check_input_nonempty;

check_input_empty:
  if input_vars = '() goto eval_prog else goto error_input_size;

check_input_nonempty:
  if input_vars = '() goto error_input_size else set_var;

eval_prog:
  blocks_lookup := hd(blocks);
  goto eval_prog_loop;

eval_prog_loop:
  curr_block := hd(blocks_lookup);
  blocks_lookup := tl(blocks_lookup);
  block_lbl := hd(curr_block);
  if next_block = block_lbl goto eval_block else goto eval_prog_loop_check;

eval_prog_loop_check:
  if blocks_lookup = '() goto error_block_lbl_missing else goto eval_prog_loop;

eval_block:
  assignments := hd(tl(curr_block));
  jump := hd(tl(tl(curr_block)));
  goto eval_assignments;

eval_assignments:
  assignment_list := assignments;
  goto eval_assignments_loop_check;

eval_assignments_loop:
  curr_assign := hd(assignment_list);
  assignment_list := tl(assignment_list);
  assgn_var := hd(curr_assign);
  expr := hd(tl(curr_assign));
  exp := call eval_expr;
  goto eval_assignments_loop_store;

eval_assignments_loop_store:
  store := cons(list(assgn_var, exp), store);
  goto eval_assignments_loop_check;

eval_assignments_loop_check:
  if assignment_list = '() goto eval_jump else goto eval_assignments_loop;

eval_expr:
  op := hd(expr);
  e0  := hd(tl(expr));
  e1 := hd(tl(tl(expr)));
  goto check_e0_lbl;

check_e0_lbl:
  if hd(e0) = 'a goto lookupe0 else goto sete0;

sete0:
  e0 := hd(tl(e0));
  goto check_e1_lbl;

check_e1_lbl:
  if hd(e1) = 'a goto lookupe1 else goto sete1;
  
sete1:
  e1 := hd(tl(e1));
  goto check_op;

lookupe0:
  lookup_var := hd(tl(e0));
  e0_var_val := call lookup;
  goto lookupe0_found;

lookupe1:
  lookup_var := hd(tl(e1));
  e1_var_val := call lookup;
  goto lookupe1_found;

lookup:
  store_lookup := store;
  goto lookup_loop;

lookup_loop:
  curr_var := hd(store_lookup);
  store_lookup := tl(store_lookup);
  var_lbl := hd(curr_var);
  var_val := hd(tl(curr_var));
  if lookup_var =  var_lbl goto found_var else goto lookup_loop_check;

lookup_loop_check:
  if store_lookup = '() goto error_var_not_found else goto lookup_loop;

found_var:
  comment := 'val_stored_in_var_val;
  return var_val;

lookupe0_found:
  e0 := e0_var_val;
  goto check_e1_lbl;

lookupe1_found:
  e1 := e1_var_val;
  goto check_op;

check_op:
  if op = 'pls do_pls else goto opcont1;
opcont1: if op = 'min do_min else goto opcont2;
opcont2: if op = 'mul do_mul else goto opcont3;
opcont3: if op = 'eql do_eql else goto opcont4;
opcont4: if op = 'lt do_lt else goto opcont5;
opcont5: if op = 'gt do_gt else goto opcont6;
opcont6: if op = 'nul do_nul else goto opcont7;
opcont7: if op = 'hd do_hd else goto opcont8;
opcont8: if op = 'tl do_tl else goto opcont9;
opcont9: if op = 'cons do_cons else goto error_op;

do_pls:
  ex := e0 + e1;
  return ex;
do_min:
  ex := e0 - e1;
  return ex;
do_mul:
  ex := e0 * e1;
  return ex;
do_eql:
  ex := e0 = e1;
  return ex;
do_lt:
  ex := e0 < e1;
  return ex;
do_gt:
  ex := e0 > e1;
  return ex;
do_nul:
  ex := e0;
  return ex;
do_hd:
  ex := hd(e0);
  return ex;
do_tl:
  ex := tl(e0);
  return ex;
do_cons:
  ex := cons(e0, e1);
  return ex;

eval_jump:
  jump_type := hd(jump);
  if jump_type = 'goto do_goto else goto jcont1;
jcont1: if jump_type = 'return do_return else goto jcont2;
jcont2: if jump_type = 'if do_if else goto error_jump_type_not_supported;

do_goto:
  next_block := hd(tl(jump));
  goto eval_prog;

do_if:
  expr := hd(tl(jump));
  thenbr := hd(tl(tl(jump)));
  elsebr := hd(tl(tl(tl(jump))));
  exp_ret := call eval_expr;
  goto do_if_check;

do_if_check:
  if exp_ret = true goto do_if_then else goto do_if_else;

do_if_then:
  next_block := thenbr;
  goto eval_prog;

do_if_else:
  next_block := elsebr;
  goto eval_prog;

do_return:
  ret := hd(tl(jump));
  type := hd(ret);
  if type = 'i goto ret_int else dr0;
dr0: if type = 'a goto ret_var else goto dr1;
dr1: if type = 'store goto ret_store else goto error_return_type;

ret_int:
  int := hd(tl(ret));
  return int;

ret_var:
  lookup_var := hd(tl(ret));
  ret_var_val := call lookup;
  goto ret_var_found;

ret_var_found:
  return ret_var_val;

ret_store:
  return store;

error_jump_type_not_supported:
  return list('error_jump_type_not_supported, jump_type);

error_input_size:
  return 'error_non_matching_size_of_input_and_vars;

error_block_lbl_missing:
  return list('error_block_not_found, next_block);

error_op:
  return list('error_op_not_found, op);

error_var_not_found:
  return list('error_var_not_found_in_store, lookup_var);

error_return_type:
  return list('error_return_type_not_known_not_return_of_expr_not_possible, type);