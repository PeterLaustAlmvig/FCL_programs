Interpreter(prog, input_vars):
init:
  store := '();
  entry := hd(prog);
  next_block := entry;
  vars := hd(tl(prog));
  blocks := tl(tl(prog));
  goto set_vars_loop;

set_vars_loop:
  if input_vars = '() goto eval_prog else goto set_var;

set_var:
  var := hd(vars);
  vars := tl(vars);
  input := hd(input_vars);
  input_vars := tl(input_vars);
  store := cons(list(var, input), store);
  if vars = '() goto check_input_empty else goto check_input_nonempty;

check_input_empty:
  if input_vars = '() goto eval_prog else goto error_input_size;

check_input_nonempty:
  if input_vars = '() goto error_input_size else set_var;

eval_prog:
  blocks_lookup := hd(blocks);
  goto eval_prog_loop;

eval_prog_loop:
  curr_block := hd(blocks_lookup);
  blocks_lookup := tl(blocks_lookup);
  block_lbl := hd(curr_block);
  if next_block = block_lbl goto eval_block else goto eval_prog_loop_check;

eval_prog_loop_check:
  if blocks_lookup = '() goto error_block_lbl_missing else goto eval_prog_loop;

eval_block:
  assignments := hd(tl(curr_block));
  jump := hd(tl(tl(curr_block)));
  goto eval_assignments;

eval_assignments:
  assignment_list := assignments;
  goto eval_assignments_loop;

eval_assignments_loop:
  curr_assign := hd(assignment_list);
  assignment_list := tl(assignment_list);
  assgn_var := hd(curr_assign);
  expr := hd(tl(curr_assign));
  goto eval_expr;

eval_expr:
  lhs := hd(expr);
  rhs := hd(tl(tl(expr)));
  op  := hd(tl(expr));
  if op = 'pls do_pls else goto opcont1;
opcont1: if op = 'min do_min else goto opcont2;
opcont2: if op = 'mul do_mul else goto opcont3;
opcont3: if op = 'eql do_eql else goto opcont4;
opcont4: if op = 'lt do_lt else goto opcont5;
opcont5: if op = 'gt do_gt else goto opcont6;
opcont6: if op = 'nul do_nul else goto error_op;

do_pls:
  ex := lhs + rhs;
  store := cons(list(assgn_var, ex), store);
  goto eval_assignments_loop_check;
do_min:
  ex := lhs - rhs;
  store := cons(list(assgn_var, ex), store);
  goto eval_assignments_loop_check;
do_mul:
  ex := lhs * rhs;
  store := cons(list(assgn_var, ex), store);
  goto eval_assignments_loop_check;
do_eql:
  ex := lhs = rhs;
  store := cons(list(assgn_var, ex), store);
  goto eval_assignments_loop_check;
do_lt:
  ex := lhs < rhs;
  store := cons(list(assgn_var, ex), store);
  goto eval_assignments_loop_check;
do_gt:
  ex := lhs > rhs;
  store := cons(list(assgn_var, ex), store);
  goto eval_assignments_loop_check;
do_nul:
  ex := lhs;
  store := cons(list(assgn_var, ex), store);
  goto eval_assignments_loop_check;

eval_assignments_loop_check:
  if assignment_list = '() goto eval_jump else goto eval_assignments_loop;

eval_jump:
  jump_type := hd(jump);
  if jump_type = 'goto do_goto else goto jcont1;
jcont1: if jump_type = 'return do_return else goto jcont2;
jcont2: if jump_type = 'if do_if else goto error_jump_type_not_supported;


do_goto:
  next_block := tl(jump);
  goto eval_prog;

do_return:
  ret := tl(jump);
  return ret;

do_if:
  ret := tl(jump);
  return ret;

error_jump_type_not_supported:
  return list('error_jump_type_not_supported, jump_type);

error_input_size:
  return 'error_non_matching_size_of_input_and_vars;

error_block_lbl_missing:
  return list('error_block_not_found, next_block);

error_op:
  return list('error_op_not_found, op);
